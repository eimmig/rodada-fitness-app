rules_version = '2';

// Security rules for the Rodada app. Paste them in Firebase console › Firestore › Rules.
// Everything requires sign-in. Each person writes only their own data.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    // Profile and running totals (total ranking reads everyone).
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isSelf(uid);
    }

    // One reading per minute: uid, name, timestamp, day, intensity, steps.
    match /readings/{id} {
      allow read: if signedIn();
      allow create: if isSelf(request.resource.data.uid);
    }

    // Daily aggregate, id "{uid}_{yyyy-MM-dd}". Group tables read other members.
    match /daily/{id} {
      allow read: if signedIn();
      allow create, update: if isSelf(request.resource.data.uid) && id.matches(request.auth.uid + '_.*');
    }

    // Groups: anyone signed in finds a group by code. Owner edits; others may only join.
    match /groups/{id} {
      allow read: if signedIn();
      allow create: if isSelf(request.resource.data.ownerUid);
      allow update: if isSelf(resource.data.ownerUid)
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames'])
            && request.auth.uid in request.resource.data.members);
    }

    // Workouts (route, time, points) are private to their owner.
    match /workouts/{id} {
      allow read: if isSelf(resource.data.uid);
      allow create, update: if isSelf(request.resource.data.uid);
    }
  }
}
